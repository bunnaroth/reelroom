{
  "name": "movie-app",
  "private": true,
  "version": "1.0.0",
  "description": "Movie App",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite client --config client/vite.config.ts",
    "dev:server": "cross-env DOTENV_CONFIG_PATH=server/.env tsx watch server/src/index.ts",
    "build": "npm run build:server && npm run build:client",
    "build:client": "tsc -b client/tsconfig.json && vite build client --config client/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "start": "cross-env DOTENV_CONFIG_PATH=server/.env node server/dist/index.js",
    "preview": "vite preview client --config client/vite.config.ts",
    "test": "vitest run --config ../client/vite.config.ts --root client",
    "lint": "eslint client"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@neon/config": "^1.14.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
